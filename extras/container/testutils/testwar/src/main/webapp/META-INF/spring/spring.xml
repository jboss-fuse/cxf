<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:jaxws="http://cxf.apache.org/jaxws"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans 
                           http://www.springframework.org/schema/beans/spring-beans-2.0.xsd
                           http://cxf.apache.org/jaxws 
                           http://cxf.apache.org/schemas/jaxws.xsd">

  <jaxws:endpoint id="GreeterPort" 
    implementor="com.iona.cxf.container.GreeterImpl" address="http://localhost:9090/GreeterContext/GreeterPort"
    wsdlLocation="greeter.wsdl"
    endpointName="e:GreeterPort"
    serviceName="s:GreeterService"
    xmlns:e="http://cxf.iona.com/test/greeter"
    xmlns:s="http://cxf.iona.com/test/greeter"/>

  <jaxws:endpoint id="GreeterPort2" 
    implementor="com.iona.cxf.container.GreeterImpl" address="http://localhost:9191/GreeterContext2/GreeterPort2"
    wsdlLocation="greeter.wsdl"
    endpointName="e:GreeterPort2"
    serviceName="s:GreeterService"
    xmlns:e="http://cxf.iona.com/test/greeter"
    xmlns:s="http://cxf.iona.com/test/greeter"/>

</beans>
